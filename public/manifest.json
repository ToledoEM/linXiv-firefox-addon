{
  "manifest_version": 3,
  "name": "linXiv Web Clipper",
  "version": "0.1.0",
  "description": "Save the page you are reading into linXiv, with metadata worked out from the page.",
  "host_permissions": [
    "https://api.crossref.org/*",
    "https://api.datacite.org/*",
    "https://export.arxiv.org/*",
    "https://eutils.ncbi.nlm.nih.gov/*"
  ],
  "action": {
    "default_title": "Clip to linXiv",
    "default_popup": "popup/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{3ead3bd7-e074-4537-9207-a3874daf4ba6}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
